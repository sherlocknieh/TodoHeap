{
  "name": "todoheap",
  "private": true,
  "scripts": {
    "dev": "cd frontend && nub run dev",
    "dev:docs": "cd docs && nub run dev",
    "dev:all": "concurrently \"nub run dev\" \"nub run dev:docs\"",
    "db:push": "node --env-file-if-exists=.env.local .scripts/db-push.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.11.1",
      "onFail": "ignore"
    }
  }
}
